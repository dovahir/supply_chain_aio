<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- ================================================================= -->
    <!-- IMPLEMENTACIÓN: Control de Stock Negativo y Series en Ubicaciones -->
    <!-- ================================================================= -->

    <!-- Vista heredada del formulario de ubicaciones de inventario -->
    <record id="view_location_form_inherit_supply_chain_aio" model="ir.ui.view">
        <field name="name">stock.location.form.inherit.supply.chain.aio</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_form" />
        <field name="arch" type="xml">
            <!-- Añadir campos de control de stock negativo y números de serie antes del uso -->
            <field name="usage" position="before">
                <field name="allow_negative_stock" />
                <field name="check_serial_no" />
            </field>
        </field>
    </record>
</odoo>
