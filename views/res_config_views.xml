<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- ================================================================= -->
    <!-- CENTRALIZACIÓN DE CONFIGURACIONES: Módulo Cadena de Suministro   -->
    <!-- ================================================================= -->

    <record id="res_config_settings_view_form_inherit_supply_chain_aio" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.supply.chain.aio</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <!-- Sección dedicada para todas las configuraciones del Módulo: Cadena de suministro -->
            <xpath expr="//app[@name='stock']" position="inside">
                <block title="Módulo: Cadena de suministro" id="supply_chain_aio_settings">
                    
                    <!-- 1. Control de Stock Negativo -->
                    <setting company_dependent="1" help="No permite cantidades de stock negativas al validar operaciones.">
                        <field name="no_negative_stock" />
                    </setting>

                    <!-- (Aquí se irán agregando las configuraciones de las próximas implementaciones) -->

                </block>
            </xpath>
        </field>
    </record>
</odoo>
