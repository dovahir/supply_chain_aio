<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- ================================================================= -->
    <!-- IMPLEMENTACIÓN: Secuencia de líneas en Formulario de Compras     -->
    <!-- ================================================================= -->

    <!-- Vista heredada del formulario de pedidos de compra / cotizaciones -->
    <record id="purchase_order_form_inherit_supply_chain_aio" model="ir.ui.view">
        <field name="name">purchase.order.view.form.inherit.supply.chain.aio</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- Añadir columna de número de secuencia antes del producto -->
            <xpath expr="//field[@name='order_line']//list//field[@name='product_id']"
                   position="before">
                <field name="sequence_number" readonly="1" invisible="display_type"/>
            </xpath>
            <!-- Añadir campo de notas en la línea de pedido -->
            <xpath expr="//field[@name='order_line']//list//field[@name='name']"
                   position="after">
                <field name="note" optional="show" invisible="display_type"/>
            </xpath>
            <!-- Añadir botón para duplicar línea de pedido -->
            <xpath expr="//field[@name='order_line']//list//field[@name='price_subtotal']"
                   position="after">
                <button name="action_copy_line"
                        type="object"
                        icon="fa-copy"
                        title="Duplicar línea"
                        aria-label="Duplicar línea"
                        invisible="display_type or parent.state in ('done', 'cancel')"/>
            </xpath>
            <!-- Añadir notas de requisición en la cabecera antes de términos y condiciones -->
            <xpath expr="//page[@name='products']/group/group/field[@name='note']"
                   position="before">
                <field colspan="2" name="req_note" placeholder="Notas transferidas desde la requisición..." invisible="not req_note" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
