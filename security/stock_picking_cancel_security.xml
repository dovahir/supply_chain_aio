<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================= -->
    <!-- PRIVILEGIO Y GRUPO DE SEGURIDAD (ODOO 19): Cancelar Transferencias-->
    <!-- ================================================================= -->

    <!-- Privilegio en la categoría nativa Cadena de Suministro -->
    <record model="res.groups.privilege" id="res_groups_privilege_stock_picking_cancel">
        <field name="name">Cancelar/Eliminar Transferencias</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
    </record>

    <!-- Grupo de permisos asociado al privilegio -->
    <record id="group_stock_picking_cancel" model="res.groups">
        <field name="name">Permitir</field>
        <field name="privilege_id" ref="res_groups_privilege_stock_picking_cancel"/>
        <field name="comment">Autoriza a los usuarios cancelar o eliminar movimientos de inventario en estado Hecho y devolverlas a borrador.</field>
    </record>

    <!-- Regla Multi-Compañía para Asignaciones de Suministro -->
    <record id="supply_chain_allocation_comp_rule" model="ir.rule">
        <field name="name">Asignación de Suministro Multi-Compañía</field>
        <field name="model_id" ref="model_supply_chain_allocation"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>

